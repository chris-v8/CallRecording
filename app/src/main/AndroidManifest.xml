<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Multi-select list for Google Phone's "Selected numbers"; contacts never leave the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Android 11+ package visibility: open Google Phone's settings after picking. -->
    <queries>
        <package android:name="com.google.android.dialer" />
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/auto_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so Google Phone's Add button can open it; it only answers
             Google Phone and this app (see NumberPickerActivity.onCreate). -->
        <activity
            android:name=".settings.NumberPickerActivity"
            android:exported="true"
            android:label="@string/picker_title" />

        <provider
            android:name=".settings.SettingsProvider"
            android:authorities="io.github.vvb2060.callrecording.settings"
            android:exported="true" />

        <meta-data
            android:name="xposeddescription"
            android:resource="@string/app_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:value="com.google.android.dialer" />
    </application>

</manifest>
